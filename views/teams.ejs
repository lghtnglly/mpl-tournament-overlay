<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MLBB Arena - Manajemen Tim</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
  <style>
    .team-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }
    .team-table th {
      padding: 14px 18px;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-muted);
      border-bottom: 1px solid var(--card-border);
    }
    .team-table td {
      padding: 14px 18px;
      font-size: 0.9rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.03);
      vertical-align: middle;
    }
    .team-table tr:hover td {
      background-color: rgba(255, 255, 255, 0.02);
    }
    .form-group {
      margin-bottom: 18px;
    }
    .form-group label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-secondary);
      margin-bottom: 8px;
    }
    .form-control {
      width: 100%;
      background: #141724;
      border: 1px solid var(--card-border);
      color: #fff;
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.2s;
    }
    .form-control:focus {
      border-color: var(--accent-primary);
    }
    .dropzone {
      border: 2px dashed rgba(255, 255, 255, 0.15);
      border-radius: 14px;
      padding: 20px;
      text-align: center;
      cursor: pointer;
      background: rgba(0, 0, 0, 0.15);
      transition: all 0.2s;
    }
    .dropzone:hover {
      border-color: var(--accent-primary);
      background: rgba(91, 84, 246, 0.05);
    }
    .batch-preview-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(91, 84, 246, 0.15);
      border: 1px solid rgba(91, 84, 246, 0.3);
      padding: 4px 10px;
      border-radius: 8px;
      font-size: 0.78rem;
      color: #C5BFFF;
    }
    .batch-preview-pill strong {
      color: var(--accent-mint);
    }
  </style>
</head>
<body>
  <div class="dashboard-wrapper">
    <%- include('partials/sidebar', { activePage: 'teams', teamCount: teams.length }) %>

    <div class="main-wrapper">
      <%- include('partials/topbar', { 
        pageTitle: 'Manajemen Tim & Peserta', 
        pageSubtitle: 'Atur daftar kontestan turnamen, input kilat baris-per-baris, dan auto-singkatan 5 karakter' 
      }) %>

      <div class="content-area">
        <!-- Bento Grid Top Row -->
        <div class="bento-grid" style="margin-bottom: 24px;">
          <!-- Card 1: Summary -->
          <div class="bento-card" style="grid-column: span 4;">
            <div style="font-size: 0.8rem; color: var(--text-secondary); font-weight: 600;">TOTAL TIM TERDAFTAR</div>
            <div style="font-size: 2.5rem; font-weight: 800; color: #fff; margin: 8px 0;" id="total-teams-count"><%= teams.length %></div>
            <div style="display: flex; gap: 8px; align-items: center; font-size: 0.78rem; color: var(--accent-mint);">
              <span class="status-dot"></span>
              Auto-Singkatan 5 Karakter Aktif (VORTONE &rarr; VRTN)
            </div>
          </div>

          <!-- Card 2: Quick Operations -->
          <div class="bento-card" style="grid-column: span 8; display: flex; align-items: center; justify-content: space-between;">
            <div>
              <h3 style="font-size: 1.1rem; font-weight: 700; color: #fff;">Input & Manajemen Tim Kilat</h3>
              <p style="font-size: 0.82rem; color: var(--text-secondary); margin-top: 4px;">Ketik daftar nama tim dipisahkan dengan Enter atau upload logo individual.</p>
            </div>
            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
              <button class="btn-primary" style="background: linear-gradient(135deg, #00E6A3, #00B894); color: #0C1D18; font-weight: 700;" onclick="openBatchModal()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                + Input Tim (Enter)
              </button>
              <button class="btn-secondary" onclick="openAddModal()">
                + Tim Tunggal
              </button>
              <button class="card-action-btn" onclick="seedDefaultTeams()">
                Reset 36 Default
              </button>
            </div>
          </div>
        </div>

        <!-- Bento Card: Main Team Roster Table -->
        <div class="bento-card" style="padding: 0;">
          <div style="padding: 20px 24px; border-bottom: 1px solid var(--card-border); display: flex; justify-content: space-between; align-items: center;">
            <div style="font-size: 1.05rem; font-weight: 700; color: #fff;">Daftar Kontestan Tim & Kelas</div>
            <div style="display: flex; gap: 10px;">
              <input type="text" id="filter-input" placeholder="Saring nama tim..." onkeyup="filterTeams()" style="background: #141724; border: 1px solid var(--card-border); color: #fff; padding: 6px 14px; border-radius: 10px; font-size: 0.82rem; outline: none;">
            </div>
          </div>

          <div style="overflow-x: auto;">
            <table class="team-table" id="teams-table">
              <thead>
                <tr>
                  <th style="width: 70px;">Seed / Slot</th>
                  <th style="width: 70px;">Logo</th>
                  <th>Nama Tim / Kelas</th>
                  <th>Tag (Maks 5 Karakter)</th>
                  <th style="text-align: right; width: 140px;">Aksi</th>
                </tr>
              </thead>
              <tbody id="teams-tbody">
                <% teams.forEach((team, index) => { %>
                  <tr data-id="<%= team.id %>" data-name="<%= team.name.toLowerCase() %>" data-short="<%= team.shortName.toLowerCase() %>">
                    <td>
                      <span style="font-weight: 700; color: var(--accent-mint); background: rgba(0,230,163,0.1); padding: 4px 10px; border-radius: 8px; font-size: 0.8rem;">
                        #<%= team.seed || (index + 1) %>
                      </span>
                    </td>
                    <td>
                      <div style="width: 38px; height: 38px; border-radius: 10px; background: #161A26; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid var(--card-border);">
                        <% if (team.logo) { %>
                          <img src="<%= team.logo %>" alt="<%= team.name %>" style="width: 100%; height: 100%; object-fit: contain;">
                        <% } else { %>
                          <span style="font-weight: 700; font-size: 0.8rem; color: var(--text-muted);"><%= team.shortName.substring(0, 3) %></span>
                        <% } %>
                      </div>
                    </td>
                    <td>
                      <div style="font-weight: 600; color: #fff;"><%= team.name %></div>
                    </td>
                    <td>
                      <span style="background: rgba(91, 84, 246, 0.15); color: #B3AEFE; font-weight: 700; font-size: 0.82rem; padding: 4px 10px; border-radius: 6px; letter-spacing: 1px;">
                        <%= team.shortName %>
                      </span>
                    </td>
                    <td style="text-align: right;">
                      <button class="card-action-btn" style="margin-right: 6px;" onclick='openEditModal(<%= JSON.stringify(team) %>)'>Edit</button>
                      <button class="btn-danger" onclick="deleteTeam(<%= team.id %>, '<%= team.name %>')">Hapus</button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Modal Batch Input Tim (Enter-Separated) -->
  <div class="modal-overlay" id="batchModal">
    <div class="modal-container" style="max-width: 640px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <div>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: #fff;">Input Tim Kilat (Pisahkan dengan Enter)</h3>
          <p style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 2px;">
            Setiap baris akan otomatis dibuatkan singkatan maksimal 5 karakter (Contoh: <strong>VORTONE &rarr; VRTN</strong>).
          </p>
        </div>
        <button onclick="closeBatchModal()" style="background: transparent; border: none; color: var(--text-secondary); cursor: pointer; font-size: 1.4rem;">&times;</button>
      </div>

      <form id="batchForm" onsubmit="handleBatchSubmit(event)">
        <div class="form-group">
          <label>Ketik atau Paste Daftar Tim di Sini:</label>
          <textarea id="batchLines" class="form-control" rows="8" style="font-family: monospace; font-size: 0.88rem; line-height: 1.5;" placeholder="Vortone&#10;XII RPL 1&#10;XII MIPA 2&#10;Sosial Satu&#10;Echo Knights&#10;..." oninput="updateBatchLivePreview()" required></textarea>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
          <div style="font-size: 0.8rem; color: var(--text-secondary);">
            Terdeteksi: <strong id="batchCountBadge" style="color: var(--accent-mint);">0 tim</strong>
          </div>
          <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.82rem; color: #fff; cursor: pointer;">
            <input type="checkbox" id="batchAppendMode" checked style="accent-color: var(--accent-primary);">
            <span>Tambahkan ke daftar yang sudah ada (Append)</span>
          </label>
        </div>

        <!-- Live Preview Singkatan -->
        <div style="background: rgba(0,0,0,0.3); border: 1px solid var(--card-border); border-radius: 12px; padding: 12px; max-height: 140px; overflow-y: auto; margin-bottom: 20px;">
          <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 8px; font-weight: 600;">LIVE PREVIEW AUTO-SINGKATAN (MAKS 5 CHAR):</div>
          <div id="batchPreviewList" style="display: flex; flex-wrap: wrap; gap: 8px;">
            <span style="font-size: 0.75rem; color: var(--text-muted);">Belum ada teks yang diketik...</span>
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 12px;">
          <button type="button" class="btn-secondary" onclick="closeBatchModal()">Batal</button>
          <button type="submit" class="btn-primary" id="saveBatchBtn">
            Simpan Seluruh Tim
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Tambah / Edit Tim Tunggal -->
  <div class="modal-overlay" id="teamModal">
    <div class="modal-container">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3 id="modalTitle" style="font-size: 1.2rem; font-weight: 700; color: #fff;">Tambah Tim Baru</h3>
        <button onclick="closeModal()" style="background: transparent; border: none; color: var(--text-secondary); cursor: pointer; font-size: 1.2rem;">&times;</button>
      </div>

      <form id="teamForm" onsubmit="handleTeamSubmit(event)">
        <input type="hidden" id="teamId" value="">
        
        <div class="form-group">
          <label>Nama Tim / Kelas</label>
          <input type="text" id="teamName" class="form-control" placeholder="Contoh: Vortone atau XII RPL 1" oninput="autoSuggestShortTag(this.value)" required>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
          <div class="form-group">
            <label>Singkatan (Maks. 5 Karakter)</label>
            <input type="text" id="teamShort" class="form-control" placeholder="VRTN" maxlength="5" required>
          </div>
          <div class="form-group">
            <label>Nomor Seed / Urutan</label>
            <input type="number" id="teamSeed" class="form-control" placeholder="1" min="1" max="64">
          </div>
        </div>

        <div class="form-group">
          <label>Upload Logo Tim (PNG/JPG/WebP/SVG)</label>
          <div class="dropzone" onclick="document.getElementById('logoFile').click()">
            <input type="file" id="logoFile" accept="image/*" style="display: none;" onchange="previewLogo(this)">
            <div id="dropzoneContent">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-primary); margin-bottom: 8px;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              <div style="font-size: 0.85rem; color: #fff;">Klik untuk pilih file logo</div>
              <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 4px;">Disarankan rasio kotak 1:1, transparan PNG</div>
            </div>
            <div id="previewContainer" style="display: none; align-items: center; justify-content: center; gap: 12px;">
              <img id="imagePreview" src="" style="width: 50px; height: 50px; object-fit: contain; border-radius: 8px; background: #111;">
              <span id="fileNamePreview" style="font-size: 0.82rem; color: #fff;"></span>
            </div>
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px;">
          <button type="button" class="btn-secondary" onclick="closeModal()">Batal</button>
          <button type="submit" class="btn-primary" id="saveBtn">Simpan Tim</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/teams.js"></script>
</body>
</html>

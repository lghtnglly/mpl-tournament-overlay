<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MLBB Arena - Pengaturan YouTube API</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-wrapper">
    <%- include('partials/sidebar', { activePage: 'youtube', teamCount: teams.length }) %>

    <div class="main-wrapper">
      <%- include('partials/topbar', { 
        pageTitle: 'YouTube Live Automation', 
        pageSubtitle: 'Integrasi YouTube Live API v3 untuk auto-update judul stream & thumbnail match' 
      }) %>

      <div class="content-area">
        <div class="bento-grid">
          <div class="bento-card" style="grid-column: span 8;">
            <div class="card-header">
              <div class="card-title">Pengaturan Integrasi YouTube Live API</div>
            </div>

            <form onsubmit="event.preventDefault(); alert('Konfigurasi YouTube Live API akan aktif di Part 3');">
              <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 6px;">Live Broadcast ID / Stream Video ID</label>
                <input type="text" class="btn-secondary" style="width: 100%; text-align: left; background: #141724;" placeholder="e.g. jfKfPfyJRdk" value="<%= settings.youtube.liveStreamId || '' %>">
              </div>

              <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 6px;">Template Judul Live Otomatis</label>
                <input type="text" class="btn-secondary" style="width: 100%; text-align: left; background: #141724;" value="<%= settings.youtube.titleTemplate %>">
                <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 4px;">Variabel tersedia: {MATCH_NO}, {TEAM_LEFT}, {TEAM_RIGHT}, {FORMAT}</div>
              </div>

              <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 6px;">Folder Thumbnail Match</label>
                <input type="text" class="btn-secondary" style="width: 100%; text-align: left; background: #141724;" value="<%= settings.youtube.thumbnailFolder %>">
                <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 4px;">Pola thumbnail: match1.jpg, match1swap.jpg, match2.jpg, dst.</div>
              </div>

              <button type="submit" class="btn-primary">Simpan Pengaturan</button>
            </form>
          </div>

          <div class="bento-card" style="grid-column: span 4;">
            <div class="card-header">
              <div class="card-title">Status API</div>
            </div>
            <div style="display: flex; flex-direction: column; gap: 14px;">
              <div style="background: rgba(255,255,255,0.03); padding: 14px; border-radius: 12px;">
                <div style="font-size: 0.75rem; color: var(--text-secondary);">STATUS AUTENTIKASI</div>
                <div style="font-weight: 700; color: var(--accent-mint); margin-top: 4px;">Siap dihubungkan (Part 3)</div>
              </div>
              <div style="background: rgba(255,255,255,0.03); padding: 14px; border-radius: 12px;">
                <div style="font-size: 0.75rem; color: var(--text-secondary);">AUTO THUMBNAIL SWITCH</div>
                <div style="font-weight: 700; color: #fff; margin-top: 4px;">match{N}.jpg &bull; swap detection</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>

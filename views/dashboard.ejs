<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MLBB Arena - Bento Match Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/bracket.css">
  <style>
    .obs-link-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      transition: all 0.2s ease;
    }
    .obs-link-row:hover {
      border-color: rgba(91, 84, 246, 0.4);
      background: rgba(91, 84, 246, 0.05);
    }
    .obs-link-label {
      font-size: 0.86rem;
      font-weight: 600;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .obs-link-url {
      font-family: monospace;
      font-size: 0.76rem;
      color: var(--accent-mint);
      margin-top: 3px;
    }
    .btn-copy {
      background: rgba(91, 84, 246, 0.2);
      border: 1px solid rgba(91, 84, 246, 0.4);
      color: #C3BEFF;
      padding: 6px 14px;
      border-radius: 10px;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }
    .btn-copy:hover {
      background: var(--accent-primary);
      color: #fff;
    }

    /* Neon Warning Toast Notification */
    .neon-toast-container {
      position: fixed;
      top: 24px;
      right: 28px;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: 12px;
      pointer-events: none;
    }
    .neon-toast {
      pointer-events: auto;
      background: #191B2E;
      border: 1px solid #FF9F43;
      border-left: 5px solid #FF9F43;
      box-shadow: 0 0 25px rgba(255, 159, 67, 0.35);
      color: #FFFFFF;
      padding: 14px 18px;
      border-radius: 14px;
      font-size: 0.86rem;
      max-width: 420px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      animation: slideInToast 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      transition: all 0.3s ease;
    }
    .neon-toast.danger {
      border-color: var(--accent-magenta);
      border-left-color: var(--accent-magenta);
      box-shadow: 0 0 25px rgba(255, 77, 137, 0.4);
    }
    .neon-toast.success {
      border-color: var(--accent-mint);
      border-left-color: var(--accent-mint);
      box-shadow: 0 0 25px var(--accent-mint-glow);
    }
    @keyframes slideInToast {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
  </style>
</head>
<body>
  <div class="dashboard-wrapper">
    <%- include('partials/sidebar', { activePage: 'dashboard', teamCount: teams.length }) %>

    <div class="main-wrapper">
      <%- include('partials/topbar', { 
        pageTitle: 'Match Control Center', 
        pageSubtitle: 'Mobile Legends Tournament Live Dashboard & Overlay Operator' 
      }) %>

      <!-- Neon Toast Floating Container -->
      <div class="neon-toast-container" id="toastContainer"></div>

      <div class="content-area">
        <!-- Bento Grid Layout -->
        <div class="bento-grid">
          
          <!-- BENTO CARD 1: ACTIVE MATCH SHOWCASE (Col Span 7) -->
          <div class="bento-card" style="grid-column: span 7;">
            <div class="card-header">
              <div class="card-title">
                <span class="status-dot"></span>
                Active Match on Broadcast
              </div>
              <span class="topbar-badge" id="round-badge" style="background: rgba(91, 84, 246, 0.2);">
                <%= tournament.currentMatch ? tournament.currentMatch.format : 'BO1' %> &bull; 
                <%= tournament.currentMatch ? tournament.currentMatch.roundName : 'Babak Penyisihan' %>
              </span>
            </div>

            <!-- Active Match Showcase Container -->
            <div class="active-showcase-container">
              <!-- Left Team (Blue Side) -->
              <div class="team-showcase-card">
                <div class="team-avatar-box blue-side" id="logo-left">
                  <% if (tournament.currentMatch && tournament.currentMatch.teamLeft && tournament.currentMatch.teamLeft.logo) { %>
                    <img src="<%= tournament.currentMatch.teamLeft.logo %>" alt="Left Logo">
                  <% } else { %>
                    <span class="placeholder-abbr" id="abbr-left">
                      <%= tournament.currentMatch && tournament.currentMatch.teamLeft ? tournament.currentMatch.teamLeft.shortName : 'TBD' %>
                    </span>
                  <% } %>
                </div>
                <h3 id="name-left" style="font-size: 1.15rem; font-weight: 700; color: #fff; text-align: center; max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  <%= tournament.currentMatch && tournament.currentMatch.teamLeft ? tournament.currentMatch.teamLeft.name : 'Team Left' %>
                </h3>
                <span style="font-size: 0.75rem; color: #8C84FE; background: rgba(91, 84, 246, 0.15); padding: 3px 12px; border-radius: 20px; font-weight: 600;">
                  BLUE SIDE
                </span>
              </div>

              <!-- Center VS & Score Tracker -->
              <div class="showcase-center">
                <div id="match-number-text" style="font-size: 0.8rem; font-weight: 700; letter-spacing: 2px; color: var(--text-muted); margin-bottom: 8px;">
                  MATCH <%= tournament.currentMatch ? tournament.currentMatch.matchNumber : '1' %>
                </div>
                <div class="score-display">
                  <span class="score-num" id="score-left"><%= tournament.currentMatch ? (tournament.currentMatch.scoreLeft || 0) : 0 %></span>
                  <span class="score-colon">:</span>
                  <span class="score-num" id="score-right"><%= tournament.currentMatch ? (tournament.currentMatch.scoreRight || 0) : 0 %></span>
                </div>
                <div style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 8px; font-weight: 500;">
                  <%= tournament.currentMatch && tournament.currentMatch.format === 'BO3' ? 'Best of 3 (First to 2)' : 'Best of 1 (Single Match)' %>
                </div>
              </div>

              <!-- Right Team (Red Side) -->
              <div class="team-showcase-card">
                <div class="team-avatar-box red-side" id="logo-right">
                  <% if (tournament.currentMatch && tournament.currentMatch.teamRight && tournament.currentMatch.teamRight.logo) { %>
                    <img src="<%= tournament.currentMatch.teamRight.logo %>" alt="Right Logo">
                  <% } else { %>
                    <span class="placeholder-abbr" id="abbr-right">
                      <%= tournament.currentMatch && tournament.currentMatch.teamRight ? tournament.currentMatch.teamRight.shortName : 'TBD' %>
                    </span>
                  <% } %>
                </div>
                <h3 id="name-right" style="font-size: 1.15rem; font-weight: 700; color: #fff; text-align: center; max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                  <%= tournament.currentMatch && tournament.currentMatch.teamRight ? tournament.currentMatch.teamRight.name : 'Team Right' %>
                </h3>
                <span style="font-size: 0.75rem; color: #FFA5C3; background: rgba(255, 77, 137, 0.15); padding: 3px 12px; border-radius: 20px; font-weight: 600;">
                  RED SIDE
                </span>
              </div>
            </div>

            <!-- Match status footer info -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px;">
              <div style="font-size: 0.8rem; color: var(--text-secondary);">
                Pemenang: <strong style="color: var(--accent-mint);"><%= tournament.currentMatch && tournament.currentMatch.winner ? tournament.currentMatch.winner.name : 'Belum Selesai' %></strong>
              </div>
              <div style="display: flex; gap: 8px;">
                <button class="card-action-btn" onclick="prevMatch()">&larr; Prev Match</button>
                <button class="card-action-btn" onclick="nextMatch()">Next Match &rarr;</button>
              </div>
            </div>
          </div>

          <!-- BENTO CARD 2: MATCH CONTROL PANEL (Col Span 5) -->
          <div class="bento-card" style="grid-column: span 5; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div class="card-header">
                <div class="card-title">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="color: var(--accent-primary);">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                  Match Control Panel
                </div>
                <span class="card-action-btn" onclick="regenerateBracket()">Reset Bracket</span>
              </div>

              <!-- Quick Control Grid Buttons -->
              <div class="control-btn-grid" style="margin-top: 10px;">
                <!-- Swap Team Button -->
                <button class="btn-ctrl btn-swap" onclick="swapTeam()">
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M7 16V4M7 4L3 8M7 4L11 8M17 8V20M17 20L21 16M17 20L13 16"></path>
                    </svg>
                    <span>Swap Team (Kiri &harr; Kanan)</span>
                  </div>
                  <span style="font-size: 0.72rem; opacity: 0.8; font-weight: normal;">Tukar posisi Blue & Red Side</span>
                </button>

                <!-- Win Left Button -->
                <button class="btn-ctrl btn-win-left" onclick="setWinner('left')">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Win Left Team</span>
                </button>

                <!-- Win Right Button -->
                <button class="btn-ctrl btn-win-right" onclick="setWinner('right')">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Win Right Team</span>
                </button>

                <!-- Next Match Button -->
                <button class="btn-ctrl btn-next-match" onclick="nextMatch()">
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <span>Next Match</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </div>
                </button>
              </div>
            </div>

            <!-- Quick SSE Status indicator -->
            <div style="margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--card-border); display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 0.78rem; color: var(--accent-mint); display: flex; align-items: center; gap: 6px;">
                <span class="status-dot"></span> Real-Time SSE Active (Instant OBS Sync)
              </span>
              <a href="/obs-links" class="card-action-btn" style="color: #fff;">Lihat Detail &rarr;</a>
            </div>
          </div>

          <!-- BENTO CARD 3: YOUTUBE LIVE STREAM CONTROL & MULTI-STREAM SWITCHER (Col Span 12) -->
          <div class="bento-card" style="grid-column: span 12; background: linear-gradient(180deg, #22283C 0%, #1A1F30 100%);">
            <div class="card-header">
              <div class="card-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #FF0000;">
                  <polygon points="23 7 16 12 23 17 23 7"></polygon>
                  <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                </svg>
                YouTube Live Stream Control & Data API v3 Automation
              </div>
              <div style="display: flex; gap: 10px; align-items: center;">
                <span class="topbar-badge" id="yt-live-status" style="background: rgba(0, 230, 163, 0.12); color: var(--accent-mint); border-color: rgba(0, 230, 163, 0.3);">
                  <span class="status-dot"></span>
                  <%= settings.youtube.liveStreamId ? 'BROADCAST CONNECTED' : 'STANDBY' %>
                </span>
                <button class="btn-primary" style="padding: 6px 14px; font-size: 0.8rem;" onclick="syncYouTubeManual()">
                  Sync Live Sekarang
                </button>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;">
              <!-- Col 1: Multi-Live Stream Switcher -->
              <div style="background: rgba(0,0,0,0.25); padding: 18px; border-radius: 14px; border: 1px solid var(--card-border);">
                <label style="display: block; font-size: 0.82rem; font-weight: 600; color: #fff; margin-bottom: 8px;">
                  Active Broadcast ID / Video ID
                </label>
                <div style="display: flex; gap: 8px;">
                  <input type="text" id="yt-stream-id" class="form-control" style="font-family: monospace; font-size: 0.82rem;" placeholder="e.g. jfKfPfyJRdk" value="<%= settings.youtube.liveStreamId || '' %>">
                  <button class="btn-secondary" style="padding: 0 14px;" onclick="saveYouTubeSettings()">Ganti</button>
                </div>
                <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 6px;">
                  Ganti Broadcast ID setiap mulai streaming baru tanpa restart server.
                </div>
              </div>

              <!-- Col 2: OAuth Token / API Key -->
              <div style="background: rgba(0,0,0,0.25); padding: 18px; border-radius: 14px; border: 1px solid var(--card-border);">
                <label style="display: block; font-size: 0.82rem; font-weight: 600; color: #fff; margin-bottom: 8px;">
                  OAuth2 Token / API Key
                </label>
                <input type="password" id="yt-oauth-token" class="form-control" style="font-family: monospace; font-size: 0.82rem;" placeholder="Bearer ya29.a0..." value="<%= settings.youtube.oauthToken || '' %>" onblur="saveYouTubeSettings()">
                <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 6px;">
                  Kunci akses YouTube Data API v3 untuk hak update judul & thumbnail.
                </div>
              </div>

              <!-- Col 3: Thumbnail Auto-Detector Info -->
              <div style="background: rgba(0,0,0,0.25); padding: 18px; border-radius: 14px; border: 1px solid var(--card-border);">
                <label style="display: block; font-size: 0.82rem; font-weight: 600; color: #fff; margin-bottom: 8px;">
                  Auto Thumbnail Asset Path
                </label>
                <div style="font-family: monospace; font-size: 0.78rem; color: var(--accent-mint); background: rgba(0,0,0,0.3); padding: 8px 12px; border-radius: 8px;">
                  public/thumbnails/match[X].jpg
                </div>
                <div style="font-size: 0.72rem; color: var(--text-secondary); margin-top: 6px;">
                  Sistem otomatis mendeteksi <code>match1.jpg</code> atau <code>match1swap.jpg</code> saat tim ditukar.
                </div>
              </div>
            </div>

            <!-- Title Template Row -->
            <div style="margin-top: 14px; background: rgba(0,0,0,0.2); padding: 12px 18px; border-radius: 12px; display: flex; align-items: center; justify-content: space-between; gap: 14px;">
              <span style="font-size: 0.8rem; color: var(--text-secondary); white-space: nowrap;">Template Judul:</span>
              <input type="text" id="yt-title-template" class="form-control" style="font-size: 0.82rem;" value="<%= settings.youtube.titleTemplate %>" onblur="saveYouTubeSettings()">
            </div>
          </div>

          <!-- BENTO CARD 4: OBS SOURCE LINKS DEDICATED (Col Span 12) -->
          <div class="bento-card" style="grid-column: span 12;">
            <div class="card-header">
              <div class="card-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="color: var(--accent-primary);">
                  <circle cx="12" cy="12" r="2"></circle>
                  <path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"></path>
                </svg>
                OBS Browser Source Dedicated Links (100% Transparan &bull; Poppins Bold 700 &bull; Auto-Sync)
              </div>
              <span class="topbar-badge" style="background: rgba(0, 230, 163, 0.15); border-color: rgba(0, 230, 163, 0.3); color: var(--accent-mint);">
                Zero Refresh Needed
              </span>
            </div>

            <p style="font-size: 0.84rem; color: var(--text-secondary); margin-bottom: 16px;">
              Gunakan link di bawah ini sebagai <strong>Browser Source</strong> di OBS Studio. Layar overlay akan otomatis update seketika saat tombol Match Controller di dashboard ditekan tanpa reload.
            </p>

            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px;">
              <!-- Overlay 1: Nama Tim Kiri -->
              <div class="obs-link-row">
                <div>
                  <div class="obs-link-label">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #5B54F6;"></span>
                    Nama Tim Kiri (Overlay)
                  </div>
                  <div class="obs-link-url" id="url-team-left-name">http://localhost:3000/overlay/team-left-name</div>
                </div>
                <div style="display: flex; gap: 8px;">
                  <a href="/overlay/team-left-name" target="_blank" class="card-action-btn">Preview</a>
                  <button class="btn-copy" onclick="copyOverlayUrl('http://localhost:3000/overlay/team-left-name')">Salin URL</button>
                </div>
              </div>

              <!-- Overlay 2: Nama Tim Kanan -->
              <div class="obs-link-row">
                <div>
                  <div class="obs-link-label">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #FF4D89;"></span>
                    Nama Tim Kanan (Overlay)
                  </div>
                  <div class="obs-link-url" id="url-team-right-name">http://localhost:3000/overlay/team-right-name</div>
                </div>
                <div style="display: flex; gap: 8px;">
                  <a href="/overlay/team-right-name" target="_blank" class="card-action-btn">Preview</a>
                  <button class="btn-copy" onclick="copyOverlayUrl('http://localhost:3000/overlay/team-right-name')">Salin URL</button>
                </div>
              </div>

              <!-- Overlay 3: Logo Tim Kiri -->
              <div class="obs-link-row">
                <div>
                  <div class="obs-link-label">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #5B54F6;"></span>
                    Logo Tim Kiri (Overlay)
                  </div>
                  <div class="obs-link-url" id="url-team-left-logo">http://localhost:3000/overlay/team-left-logo</div>
                </div>
                <div style="display: flex; gap: 8px;">
                  <a href="/overlay/team-left-logo" target="_blank" class="card-action-btn">Preview</a>
                  <button class="btn-copy" onclick="copyOverlayUrl('http://localhost:3000/overlay/team-left-logo')">Salin URL</button>
                </div>
              </div>

              <!-- Overlay 4: Logo Tim Kanan -->
              <div class="obs-link-row">
                <div>
                  <div class="obs-link-label">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #FF4D89;"></span>
                    Logo Tim Kanan (Overlay)
                  </div>
                  <div class="obs-link-url" id="url-team-right-logo">http://localhost:3000/overlay/team-right-logo</div>
                </div>
                <div style="display: flex; gap: 8px;">
                  <a href="/overlay/team-right-logo" target="_blank" class="card-action-btn">Preview</a>
                  <button class="btn-copy" onclick="copyOverlayUrl('http://localhost:3000/overlay/team-right-logo')">Salin URL</button>
                </div>
              </div>
            </div>
          </div>

          <!-- BENTO CARD 5: INTERACTIVE BRACKET VIEWER (Col Span 12) -->
          <div class="bento-card" style="grid-column: span 12;">
            <div class="card-header">
              <div class="card-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-mint);">
                  <line x1="6" y1="3" x2="6" y2="15"></line>
                  <circle cx="18" cy="6" r="3"></circle>
                  <circle cx="6" cy="18" r="3"></circle>
                  <path d="M18 9a9 9 0 0 1-9 9"></path>
                </svg>
                Interactive Bracket Viewer (36 Tim &bull; Single Elimination)
              </div>
              <div style="display: flex; gap: 10px; align-items: center;">
                <span style="font-size: 0.75rem; color: var(--text-secondary);">&bull; Klik salah satu match node untuk menjadikannya match aktif</span>
                <button class="btn-secondary" style="padding: 6px 14px; font-size: 0.8rem;" onclick="regenerateBracket()">Acak & Generate Bagan</button>
              </div>
            </div>

            <!-- Bracket Tree Horizontal Scrolling Area -->
            <div class="bracket-scroll-container">
              <% (tournament.rounds || []).forEach((round, rIdx) => { %>
                <div class="bracket-round-col">
                  <div class="bracket-round-header">
                    <h4><%= round.roundName %></h4>
                    <span><%= round.matches[0] ? round.matches[0].format : 'BO1' %></span>
                  </div>

                  <div class="bracket-round-matches">
                    <% round.matches.forEach(match => { %>
                      <% if (!match.isBye) { %>
                        <div class="match-node <%= tournament.currentMatch && tournament.currentMatch.id === match.id ? 'active-match' : '' %>" 
                             data-match-id="<%= match.id %>"
                             onclick="selectMatch('<%= match.id %>')">
                          <div class="match-node-header">
                            <span>MATCH #<%= match.matchNumber %></span>
                            <span style="color: <%= match.status === 'COMPLETED' ? 'var(--accent-mint)' : 'var(--text-muted)' %>">
                              <%= match.status === 'COMPLETED' ? 'SELESAI' : 'TERJADWAL' %>
                            </span>
                          </div>

                          <!-- Team Left in Bracket Node -->
                          <div class="match-team-row <%= match.winner && match.teamLeft && match.winner.id === match.teamLeft.id ? 'winner' : '' %>">
                            <div class="match-team-info">
                              <span style="color: var(--text-muted); font-size: 0.72rem;">#<%= match.teamLeft?.seed || '-' %></span>
                              <span style="font-weight: 600;"><%= match.teamLeft ? match.teamLeft.name : 'TBD' %></span>
                            </div>
                            <span class="match-team-score"><%= match.scoreLeft || 0 %></span>
                          </div>

                          <!-- Team Right in Bracket Node -->
                          <div class="match-team-row <%= match.winner && match.teamRight && match.winner.id === match.teamRight.id ? 'winner' : '' %>">
                            <div class="match-team-info">
                              <span style="color: var(--text-muted); font-size: 0.72rem;">#<%= match.teamRight?.seed || '-' %></span>
                              <span style="font-weight: 600;"><%= match.teamRight ? match.teamRight.name : 'TBD' %></span>
                            </div>
                            <span class="match-team-score"><%= match.scoreRight || 0 %></span>
                          </div>
                        </div>
                      <% } %>
                    <% }) %>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <script src="/js/matchControl.js"></script>
  <script>
    function copyOverlayUrl(url) {
      navigator.clipboard.writeText(url).then(() => {
        showToast('URL Overlay berhasil disalin: ' + url, 'success');
      }).catch(err => {
        prompt('Salin URL ini:', url);
      });
    }

    // Save YouTube API Settings & Switcher
    async function saveYouTubeSettings() {
      const liveStreamId = document.getElementById('yt-stream-id').value;
      const oauthToken = document.getElementById('yt-oauth-token').value;
      const titleTemplate = document.getElementById('yt-title-template').value;

      try {
        const res = await fetch('/api/youtube/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ liveStreamId, oauthToken, titleTemplate })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          showToast('Pengaturan YouTube berhasil disimpan', 'success');
        }
      } catch (e) {
        showToast('Gagal menyimpan pengaturan YouTube', 'danger');
      }
    }

    // Trigger Manual YouTube Sync
    async function syncYouTubeManual() {
      try {
        const res = await fetch('/api/youtube/sync', { method: 'POST' });
        const data = await res.json();
        if (data.result && data.result.warning) {
          showToast(data.result.warning, 'warning');
        } else {
          showToast('YouTube sync berhasil: ' + data.result.newTitle, 'success');
        }
      } catch (e) {
        showToast('Gagal sinkronisasi YouTube', 'danger');
      }
    }

    // Floating Neon Toast Notification Function
    function showToast(message, type = 'warning') {
      const container = document.getElementById('toastContainer');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = `neon-toast ${type}`;

      let icon = '⚠️';
      if (type === 'danger') icon = '⛔';
      if (type === 'success') icon = '✅';

      toast.innerHTML = `
        <span style="font-size: 1.1rem;">${icon}</span>
        <div style="flex: 1;">
          <div style="font-weight: 700; margin-bottom: 2px;">
            ${type === 'warning' ? 'Peringatan YouTube Asset' : (type === 'danger' ? 'Error' : 'Sukses')}
          </div>
          <div>${message}</div>
        </div>
      `;

      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-10px)';
        setTimeout(() => toast.remove(), 300);
      }, 5000);
    }
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MLBB Arena - Cloud, Firebase & ImageKit Integration</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-wrapper">
    <%- include('partials/sidebar', { activePage: 'cloud', teamCount: teams.length }) %>

    <div class="main-wrapper">
      <%- include('partials/topbar', { 
        pageTitle: 'Online Cloud, Firebase & ImageKit', 
        pageSubtitle: 'Deploy 24 Jam di Cloudflare, Database Realtime di Firebase, dan Media Storage di ImageKit' 
      }) %>

      <div class="content-area">
        <div class="bento-grid">
          
          <!-- BENTO CARD 1: CLOUDFLARE DEPLOYMENT (Col Span 12) -->
          <div class="bento-card" style="grid-column: span 12;">
            <div class="card-header">
              <div class="card-title">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #F38020;">
                  <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path>
                </svg>
                1. Cloudflare Deployment (Pages & Tunnel 24 Jam Nonstop)
              </div>
              <span class="topbar-badge" id="cf-badge" style="background: <%= settings.cloudflare && settings.cloudflare.publicUrl ? 'rgba(0, 230, 163, 0.15)' : 'rgba(255, 255, 255, 0.05)' %>; color: <%= settings.cloudflare && settings.cloudflare.publicUrl ? 'var(--accent-mint)' : 'var(--text-secondary)' %>;">
                <span class="status-dot"></span>
                <%= settings.cloudflare && settings.cloudflare.publicUrl ? 'CONNECTED' : 'STANDBY' %>
              </span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
              <div>
                <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 14px;">
                  Hubungkan server atau deploy proyek ke jaringan global <strong>Cloudflare</strong> untuk akses instan via internet tanpa batasan firewall atau port-forwarding.
                </p>
                <div style="background: rgba(0,0,0,0.3); padding: 14px; border-radius: 12px; border: 1px solid var(--card-border);">
                  <label style="font-size: 0.78rem; font-weight: 700; color: #fff; display: block; margin-bottom: 6px;">
                    URL Domain Cloudflare Anda (HTTPS):
                  </label>
                  <input type="text" id="cf-public-url" class="form-control" style="font-family: monospace; font-size: 0.85rem;" placeholder="https://mpl-tournament.pages.dev atau https://xxxx.trycloudflare.com" value="<%= settings.cloudflare ? (settings.cloudflare.publicUrl || '') : '' %>">
                  <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 6px;">
                    URL ini akan otomatis digunakan oleh OBS Browser Sources & Dashboard Admin saat online.
                  </div>
                </div>
              </div>

              <!-- Panduan Cloudflare -->
              <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--card-border); border-radius: 12px; padding: 16px; font-size: 0.82rem; line-height: 1.6;">
                <strong style="color: #FFFFFF; display: block; margin-bottom: 6px;">Opsi Deployment Cloudflare:</strong>
                <ul style="padding-left: 18px; color: var(--text-secondary); margin-bottom: 10px;">
                  <li><strong>Cloudflare Quick Tunnel</strong>: Jalankan <code>npx cloudflared tunnel --url http://localhost:3000</code></li>
                  <li><strong>Cloudflare Pages / Workers</strong>: Hubungkan langsung repositori GitHub ke Cloudflare Pages (Free Tier 100% tanpa kartu kredit).</li>
                </ul>
                <div style="background: #11141F; padding: 8px 12px; border-radius: 8px; font-family: monospace; color: var(--accent-mint); font-size: 0.76rem; display: flex; justify-content: space-between; align-items: center;">
                  <span>npx cloudflared tunnel --url http://localhost:3000</span>
                  <button class="card-action-btn" onclick="navigator.clipboard.writeText('npx cloudflared tunnel --url http://localhost:3000'); alert('Perintah disalin!');">Salin</button>
                </div>
              </div>
            </div>
          </div>

          <!-- BENTO CARD 2: FIREBASE REALTIME DATABASE (Col Span 6) -->
          <div class="bento-card" style="grid-column: span 6;">
            <div class="card-header">
              <div class="card-title">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #FFA000;">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                2. Firebase Realtime Database
              </div>
              <span class="topbar-badge" id="fb-badge" style="background: <%= settings.firebase && settings.firebase.enabled ? 'rgba(0, 230, 163, 0.15)' : 'rgba(255, 255, 255, 0.05)' %>; color: <%= settings.firebase && settings.firebase.enabled ? 'var(--accent-mint)' : 'var(--text-secondary)' %>;">
                <span class="status-dot"></span>
                <%= settings.firebase && settings.firebase.enabled ? 'ACTIVE' : 'OFFLINE' %>
              </span>
            </div>

            <p style="font-size: 0.84rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 16px;">
              Data tim, skor, dan match aktif otomatis disinkronkan ke <strong>Firebase Realtime Database</strong> secara live setiap ada aksi pertandingan.
            </p>

            <div style="margin-bottom: 14px;">
              <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; font-weight: 600; color: #fff; cursor: pointer;">
                <input type="checkbox" id="fb-enabled" <%= settings.firebase && settings.firebase.enabled ? 'checked' : '' %> style="accent-color: var(--accent-primary); width: 16px; height: 16px;">
                <span>Aktifkan Sinkronisasi Firebase Realtime</span>
              </label>
            </div>

            <div style="margin-bottom: 14px;">
              <label style="display: block; font-size: 0.78rem; font-weight: 600; color: #fff; margin-bottom: 6px;">
                Firebase Database URL
              </label>
              <input type="text" id="fb-database-url" class="form-control" style="font-family: monospace; font-size: 0.82rem;" placeholder="https://projek-anda-default-rtdb.firebaseio.com" value="<%= settings.firebase ? (settings.firebase.databaseUrl || '') : '' %>">
            </div>

            <div style="margin-bottom: 16px;">
              <label style="display: block; font-size: 0.78rem; font-weight: 600; color: #fff; margin-bottom: 6px;">
                Database Secret / Auth Token (Opsional)
              </label>
              <input type="password" id="fb-auth-token" class="form-control" style="font-family: monospace; font-size: 0.82rem;" placeholder="Database Secret atau kosongkan jika rules .read/.write: true" value="<%= settings.firebase ? (settings.firebase.authToken || '') : '' %>">
            </div>

            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
              <button class="btn-secondary" onclick="pushToFirebase()">Push Data Sekarang</button>
              <button class="btn-secondary" onclick="pullFromFirebase()">Unduh dari Firebase</button>
            </div>
          </div>

          <!-- BENTO CARD 3: IMAGEKIT.IO CLOUD MEDIA STORAGE (Col Span 6) -->
          <div class="bento-card" style="grid-column: span 6;">
            <div class="card-header">
              <div class="card-title">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #00B4D8;">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
                3. ImageKit.io Cloud Storage (CDN)
              </div>
              <span class="topbar-badge" id="ik-badge" style="background: <%= settings.imagekit && settings.imagekit.enabled ? 'rgba(0, 230, 163, 0.15)' : 'rgba(255, 255, 255, 0.05)' %>; color: <%= settings.imagekit && settings.imagekit.enabled ? 'var(--accent-mint)' : 'var(--text-secondary)' %>;">
                <span class="status-dot"></span>
                <%= settings.imagekit && settings.imagekit.enabled ? 'ACTIVE' : 'OFFLINE' %>
              </span>
            </div>

            <p style="font-size: 0.84rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 16px;">
              Simpan seluruh logo tim dan gambar pertandingan di <strong>ImageKit.io</strong>. Logo langsung dihosting di Cloud CDN global gratis, cepat, dan tidak hilang saat redeploy.
            </p>

            <div style="margin-bottom: 14px;">
              <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; font-weight: 600; color: #fff; cursor: pointer;">
                <input type="checkbox" id="ik-enabled" <%= settings.imagekit && settings.imagekit.enabled ? 'checked' : '' %> style="accent-color: #00B4D8; width: 16px; height: 16px;">
                <span>Aktifkan Upload Logo ke ImageKit Cloud</span>
              </label>
            </div>

            <div style="margin-bottom: 12px;">
              <label style="display: block; font-size: 0.78rem; font-weight: 600; color: #fff; margin-bottom: 6px;">
                URL Endpoint ImageKit
              </label>
              <input type="text" id="ik-url-endpoint" class="form-control" style="font-family: monospace; font-size: 0.82rem;" placeholder="https://ik.imagekit.io/username" value="<%= settings.imagekit ? (settings.imagekit.urlEndpoint || '') : '' %>">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
              <div>
                <label style="display: block; font-size: 0.78rem; font-weight: 600; color: #fff; margin-bottom: 6px;">
                  Public Key
                </label>
                <input type="text" id="ik-public-key" class="form-control" style="font-family: monospace; font-size: 0.82rem;" placeholder="public_xxxx..." value="<%= settings.imagekit ? (settings.imagekit.publicKey || '') : '' %>">
              </div>
              <div>
                <label style="display: block; font-size: 0.78rem; font-weight: 600; color: #fff; margin-bottom: 6px;">
                  Private Key
                </label>
                <input type="password" id="ik-private-key" class="form-control" style="font-family: monospace; font-size: 0.82rem;" placeholder="private_xxxx..." value="<%= settings.imagekit ? (settings.imagekit.privateKey || '') : '' %>">
              </div>
            </div>

            <div style="font-size: 0.72rem; color: var(--text-muted); line-height: 1.5;">
              Daftar gratis di <strong>https://imagekit.io</strong> (Gratis 20GB bandwidth & storage tanpa kartu kredit). Ambil kredensial di menu <em>Developer options</em>.
            </div>
          </div>

          <!-- Bottom Action Button Bar -->
          <div class="bento-card" style="grid-column: span 12; display: flex; justify-content: space-between; align-items: center;">
            <div style="font-size: 0.84rem; color: var(--text-secondary);">
              Semua pengaturan cloud akan disimpan dan diterapkan secara instan ke server.
            </div>
            <button class="btn-primary" style="padding: 12px 28px; font-size: 0.95rem;" onclick="saveAllCloudSettings()">
              Simpan Seluruh Pengaturan Cloud
            </button>
          </div>

        </div>
      </div>
    </div>
  </div>

  <script>
    async function saveAllCloudSettings() {
      const publicUrl = document.getElementById('cf-public-url').value.trim();
      const firebaseEnabled = document.getElementById('fb-enabled').checked;
      const databaseUrl = document.getElementById('fb-database-url').value.trim();
      const authToken = document.getElementById('fb-auth-token').value.trim();

      const imagekitEnabled = document.getElementById('ik-enabled').checked;
      const urlEndpoint = document.getElementById('ik-url-endpoint').value.trim();
      const publicKey = document.getElementById('ik-public-key').value.trim();
      const privateKey = document.getElementById('ik-private-key').value.trim();

      try {
        const res = await fetch('/api/cloud/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            publicUrl, 
            firebaseEnabled, databaseUrl, authToken,
            imagekitEnabled, urlEndpoint, publicKey, privateKey
          })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          alert('Pengaturan Cloud (Cloudflare, Firebase, & ImageKit) berhasil disimpan!');
          window.location.reload();
        } else {
          alert(data.error || 'Gagal menyimpan pengaturan');
        }
      } catch (err) {
        alert('Kesalahan jaringan saat menyimpan');
      }
    }

    async function pushToFirebase() {
      try {
        const res = await fetch('/api/cloud/firebase/push', { method: 'POST' });
        const data = await res.json();
        if (res.ok && data.success) {
          alert('Seluruh data tim dan turnamen berhasil di-push ke Firebase Cloud Database!');
        } else {
          alert(data.error || 'Gagal push ke Firebase');
        }
      } catch (err) {
        alert('Gagal menghubungi server');
      }
    }

    async function pullFromFirebase() {
      if (!confirm('Ini akan menimpa data lokal dengan data dari Firebase. Lanjutkan?')) return;
      try {
        const res = await fetch('/api/cloud/firebase/pull', { method: 'POST' });
        const data = await res.json();
        if (res.ok && data.success) {
          alert('Data berhasil disinkronkan dari Firebase! Halaman akan reload.');
          window.location.reload();
        } else {
          alert(data.error || 'Gagal download dari Firebase');
        }
      } catch (err) {
        alert('Gagal menghubungi server');
      }
    }
  </script>
</body>
</html>

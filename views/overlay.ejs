<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>OBS - <%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700&display=swap" rel="stylesheet">
  <style>
    /* ATURAN OBS OVERLAY KETAT:
       1. Full background 100% transparan (background: transparent)
       2. Font: Poppins Bold 700 murni
       3. HANYA TEKS MURNI / LOGO MURNI
       4. TANPA background box, TANPA border, TANPA glow, TANPA stroke, TANPA shadow atau efek apa pun
       5. Format Dua Baris Simetris Terpusat:
          - Baris 1: Nama Tim / Singkatan UPPERCASE
          - Baris 2: Wajib teks "SMADA" UPPERCASE (proporsional sedikit lebih kecil, tetap bold)
    */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      border: 0;
      outline: 0;
      background: transparent !important;
      box-shadow: none !important;
      text-shadow: none !important;
      filter: none !important;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .obs-text-container {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      line-height: 1.1;
    }

    /* Baris 1: Nama Tim / Kelas (Uppercase, max-length consideration) */
    .obs-team-name {
      color: #FFFFFF;
      font-size: 3.4rem;
      font-weight: 700;
      letter-spacing: 1px;
      white-space: nowrap;
      text-transform: uppercase;
    }

    /* Baris 2: Sub-teks wajib "SMADA" proporsional rapi */
    .obs-team-sub {
      color: #FFFFFF;
      font-size: 2.1rem;
      font-weight: 700;
      letter-spacing: 2px;
      margin-top: 4px;
      white-space: nowrap;
      text-transform: uppercase;
      opacity: 0.95;
    }

    .obs-logo-container {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .obs-team-logo {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      display: block;
    }

    .obs-empty {
      display: none;
    }
  </style>
</head>
<body>
  <% if (type === 'name') { %>
    <div class="obs-text-container">
      <div class="obs-team-name" id="display-team-name"><%= formattedName || '' %></div>
      <div class="obs-team-sub">SMADA</div>
    </div>
  <% } else if (type === 'logo') { %>
    <div class="obs-logo-container">
      <img class="obs-team-logo <%= logoUrl ? '' : 'obs-empty' %>" id="display-logo" src="<%= logoUrl || '' %>" alt="Team Logo">
    </div>
  <% } %>

  <script>
    const targetSide = '<%= side %>';   // 'left' | 'right'
    const targetType = '<%= type %>';   // 'name' | 'logo'

    // Format Nama Tim di Client jika menerima SSE update
    function formatTeamNameClient(name, shortName) {
      if (!name) return '';
      name = name.trim();
      if (name.length <= 8) return name.toUpperCase();
      if (shortName && shortName.trim().length > 0 && shortName.trim().length <= 8) {
        return shortName.trim().toUpperCase();
      }
      let s = name.toUpperCase()
        .replace(/SOSIAL/gi, 'SOS')
        .replace(/PENGETAHUAN ALAM/gi, 'IPA')
        .replace(/PENGETAHUAN SOSIAL/gi, 'IPS')
        .replace(/KELAS\s*/gi, '')
        .replace(/SATU/gi, '1')
        .replace(/DUA/gi, '2')
        .replace(/TIGA/gi, '3')
        .replace(/EMPAT/gi, '4')
        .replace(/\s+/g, ' ')
        .trim();
      if (s.length <= 8) return s;
      const compact = s.replace(/\s+/g, '');
      if (compact.length <= 8) return compact;
      const words = name.split(/\s+/).filter(Boolean);
      if (words.length > 1) {
        const acronym = words.map(w => w[0]).join('').toUpperCase();
        if (acronym.length >= 2 && acronym.length <= 8) return acronym;
      }
      return compact.substring(0, 8);
    }

    function applyMatchData(match) {
      if (!match) return;
      const team = targetSide === 'left' ? match.teamLeft : match.teamRight;

      if (targetType === 'name') {
        const textEl = document.getElementById('display-team-name');
        if (textEl && team) {
          textEl.textContent = formatTeamNameClient(team.name, team.shortName);
        }
      } else if (targetType === 'logo') {
        const imgEl = document.getElementById('display-logo');
        if (imgEl) {
          if (team && team.logo) {
            imgEl.src = team.logo;
            imgEl.classList.remove('obs-empty');
          } else {
            imgEl.src = '';
            imgEl.classList.add('obs-empty');
          }
        }
      }
    }

    // Koneksi Real-Time SSE (Server-Sent Events)
    function initSSE() {
      const eventSource = new EventSource('/api/events');

      eventSource.onmessage = function(e) {
        try {
          const payload = JSON.parse(e.data);
          if (payload && payload.type === 'MATCH_UPDATE') {
            applyMatchData(payload.match);
          }
        } catch (err) {
          console.error('[OBS SSE Error]', err);
        }
      };

      eventSource.onerror = function() {
        eventSource.close();
        setTimeout(initSSE, 2000);
      };
    }

    initSSE();
  </script>
</body>
</html>
